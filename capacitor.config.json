{
  "appId": "ng.enactus.admin",
  "appName": "Enactus NG",
  "webDir": "www",
  "backgroundColor": "#18130E",
  "server": {
    "androidScheme": "https",
    "allowNavigation": []
  },
  "android": {
    "backgroundColor": "#18130E",
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 2000,
      "backgroundColor": "#18130E",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    }
  }
}
